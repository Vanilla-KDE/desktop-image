#!/bin/bash

MARKER="$HOME/.local/state/setup-user-profile-done"

# Wallpapers

WALLPAPER="/usr/share/wallpapers/fairy-tale"

[ -f "$MARKER" ] && exit 0

plasma-apply-wallpaperimage "$WALLPAPER"

kwriteconfig6 --file kscreenlockerrc --group Greeter --group Wallpaper --group org.kde.image --group General --key Image "$WALLPAPER"

# Marker

mkdir -p "$(dirname "$MARKER")"
touch "$MARKER"


